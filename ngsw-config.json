{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/assets/textures/**",
          "/images/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "wasm-onnx-models",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(wasm|onnx|wgsl|bin)",
          "/assets/models/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-network-first",
      "urls": [
        "/api/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "10m",
        "timeout": "10s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/docs",
    "!/docs/**",
    "!/api-docs",
    "!/api-docs/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}